---
import { skills } from "../data/profile";

interface Props {
  tone: "dark" | "light";
}

const { tone } = Astro.props;
const label = tone === "dark" ? "text-navy-300" : "text-muted";
const tag = tone === "dark" ? "bg-navy-700 text-navy-100" : "bg-accent-soft text-accent";
---

<div class="grid gap-3">
  {
    skills.map((s) => (
      <div class="grid gap-1.5">
        <span class={`text-xs ${label}`}>{s.group}</span>
        <ul class="flex flex-wrap gap-1.5">
          {s.items.map((item) => (
            <li class={`rounded-full px-2.5 py-0.5 text-[12.5px] ${tag}`}>{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
