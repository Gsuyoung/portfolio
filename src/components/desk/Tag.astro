---
import DotText from "../DotText.astro";
---

<div class="tag" aria-hidden="true">
  <div class="face"><DotText text="GSY" color="#141414" font="mono" density={14} align="center" class="dots" /></div>
</div>

<style>
  .tag {
    position: absolute;
    right: 9%;
    top: 470px;
    width: 230px;
    height: 96px;
    z-index: 4;
    padding: 9px;
    border-radius: 12px;
    background: linear-gradient(145deg, #fafafa, #d8d8d8 55%, #bdbdbd);
    box-shadow: 0 20px 40px -18px rgb(0 0 0 / 0.8);
    transform: rotate(-14deg);
  }
  .tag::before {
    content: "";
    position: absolute;
    left: -26px;
    top: 32px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 5px solid #cfcfcf;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.5);
  }
  .face {
    height: 100%;
    border-radius: 6px;
    background: #f6f6f4;
    border: 1px solid #a9a9a9;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .face :global(.dots) {
    width: 92%;
    height: 70%;
  }
  @media (max-width: 900px) {
    .tag {
      position: relative;
      right: auto;
      top: auto;
      width: 200px;
      height: 84px;
      justify-self: start;
      margin: 14px 0 0 30px;
      transform: rotate(-8deg);
    }
  }
</style>
