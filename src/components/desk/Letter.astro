---
import { profile } from "../../data/profile";
import { letterParagraphs } from "../../lib/projects";

const today = new Intl.DateTimeFormat("ko-KR", {
  timeZone: "Asia/Seoul",
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
})
  .format(new Date())
  .replace(/\.$/, "");
const github = profile.github.replace("https://", "");
---

<article class="sheet letter" aria-label="자기소개 서신">
  <div class="head">
    <div><div class="label">From</div><div class="who">{profile.nameEn}</div><div class="addr">{profile.email}</div></div>
    <div><div class="label">To</div><div class="who">HIRING TEAM</div><div class="addr">{github}</div></div>
  </div>
  <div class="body">
    <p class="dear">안녕하세요, 백엔드 개발자 {profile.name}입니다.</p>
    {letterParagraphs(profile).map((p) => <p>{p}</p>)}
  </div>
  <div class="foot">
    <div><div class="label">Date</div><div class="date">{today}</div></div>
    <div><div class="label">Signature</div><div class="sign">{profile.nameSign}</div></div>
  </div>
</article>

<style>
  .letter {
    position: absolute;
    left: 40%;
    top: 120px;
    width: 40%;
    min-height: 520px;
    transform: rotate(6deg);
    z-index: 3;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  .head,
  .foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .head {
    border-bottom: 1.5px solid var(--color-ink);
  }
  .foot {
    border-top: 1.5px solid var(--color-ink);
  }
  .head > div,
  .foot > div {
    padding: 12px 16px;
    border-right: 1px solid var(--color-ink);
    min-width: 0;
  }
  .head > div:last-child,
  .foot > div:last-child {
    border-right: 0;
  }
  .who {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.06em;
  }
  .addr {
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .body {
    padding: 22px 22px 18px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.9;
  }
  .body p {
    margin: 0 0 10px;
  }
  .dear {
    font-weight: 600;
    font-size: 14px;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .sign {
    font-family: var(--font-mono);
    font-style: italic;
    font-size: 20px;
    margin-top: 4px;
  }
  @media (max-width: 900px) {
    .letter {
      position: relative;
      left: auto;
      top: auto;
      width: 92%;
      min-height: 0;
      justify-self: end;
      margin-top: -40px;
      transform: rotate(2.5deg);
    }
  }
  @media (max-width: 520px) {
    .head,
    .foot {
      grid-template-columns: 1fr;
    }
    .head > div,
    .foot > div {
      border-right: 0;
      border-bottom: 1px solid var(--color-ink);
    }
    .head > div:last-child,
    .foot > div:last-child {
      border-bottom: 0;
    }
  }
</style>
