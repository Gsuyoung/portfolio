---
import DotText from "../DotText.astro";
import { profile, skills } from "../../data/profile";

const year = new Date().getFullYear();
// 그룹마다 대표 기술 하나씩
const headline = skills.map((s) => s.items[0]).join(" · ");
// 바코드 막대 폭(px). 짝수 번째만 칠합니다.
const bars = [2, 1, 1, 3, 1, 2, 1, 1, 2, 3, 1, 1, 2, 1, 3, 1, 2, 1, 1, 2, 1, 3, 2, 1];
---

<div class="sheet cover">
  <div class="top label"><span>Portfolio · Vol.01</span><span>{year}</span></div>
  <DotText text={profile.name} color="#3b2c18" font="sans" density={26} class="name" />
  <div class="bottom">
    <div>
      <div class="role">{profile.role.toUpperCase()}</div>
      <div class="label mt-1">{headline}</div>
    </div>
    <div class="barcode" aria-hidden="true">
      {bars.map((w, i) => <i style={`width:${w}px;opacity:${i % 2 ? 0 : 1}`} />)}
    </div>
  </div>
</div>

<style>
  .cover {
    position: absolute;
    left: 0;
    top: 30px;
    width: 46%;
    height: 470px;
    transform: rotate(-4deg);
    padding: 30px 34px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background-color: var(--color-kraft);
    background-image: radial-gradient(rgb(0 0 0 / 0.05) 1px, transparent 1px);
    background-size: 3px 3px;
    color: var(--color-kraft-ink);
  }
  .top,
  .bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .bottom {
    align-items: end;
  }
  .role {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
  }
  .barcode {
    display: flex;
    gap: 2px;
    height: 34px;
  }
  .barcode i {
    display: block;
    background: var(--color-kraft-ink);
  }
  @media (max-width: 900px) {
    .cover {
      position: relative;
      left: auto;
      top: auto;
      width: auto;
      height: 340px;
      transform: rotate(-2deg);
    }
  }
</style>
