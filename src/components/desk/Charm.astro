---
// 서신의 서명 칸 위에 서 있는 비즈 캐릭터.
// 원본 PNG(src/assets/bead-charm.png)를 scripts/bead-to-svg.mjs 로 구슬 하나당 입체 구슬 하나씩 다시 그린 SVG 입니다.
// 서명 칸(position: relative) 안에 두면 발이 칸 위쪽 선에 살짝 걸칩니다.
import Bead from "../../assets/bead-charm.svg";
---

<div class="charm" aria-hidden="true">
  <div class="figure"><Bead class="bead" /></div>
</div>

<style>
  .charm {
    position: absolute;
    right: 14px;
    bottom: calc(100% - 22px);
    z-index: 2;
    width: 104px;
  }
  /* 발밑에 떨어지는 접지 그림자 */
  .charm::after {
    content: "";
    position: absolute;
    left: 18%;
    right: 18%;
    bottom: -3px;
    height: 8px;
    border-radius: 50%;
    background: radial-gradient(rgb(0 0 0 / 0.35), transparent 70%);
    animation: shadow 1.8s ease-in-out infinite alternate;
  }
  .figure {
    transform-origin: 50% 100%;
    animation: sway 1.8s ease-in-out infinite alternate;
  }
  .figure :global(.bead) {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(1px 3px 2px rgb(0 0 0 / 0.35));
  }
  /* 마우스를 올리면 한 번 통통 뜁니다. */
  .charm:hover .figure {
    animation: hop 0.5s ease-out;
  }
  @keyframes sway {
    from {
      transform: rotate(-3deg);
    }
    to {
      transform: rotate(3deg);
    }
  }
  @keyframes shadow {
    from {
      transform: translateX(-3px);
    }
    to {
      transform: translateX(3px);
    }
  }
  @keyframes hop {
    0%,
    100% {
      transform: translateY(0) scale(1, 1);
    }
    20% {
      transform: translateY(0) scale(1.06, 0.94);
    }
    50% {
      transform: translateY(-14px) scale(0.97, 1.03);
    }
    80% {
      transform: translateY(0) scale(1.04, 0.96);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .figure,
    .charm::after,
    .charm:hover .figure {
      animation: none;
    }
  }
  @media (max-width: 900px) {
    .charm {
      width: 70px;
      right: 10px;
    }
  }
</style>
