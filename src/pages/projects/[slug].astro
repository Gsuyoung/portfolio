---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { profile } from "../../data/profile";
import { inline } from "../../lib/text";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const meta = [
  { label: "기간", value: d.period },
  { label: "역할", value: d.role },
  ...(d.team ? [{ label: "팀", value: d.team }] : []),
  { label: "기술", value: d.stack.join(", ") },
];
const steps = [
  { label: "문제", key: "problem" },
  { label: "원인", key: "cause" },
  { label: "해결", key: "solution" },
  { label: "결과", key: "result" },
] as const;
---

<Layout title={`${d.title} | ${profile.name}`} description={d.summary}>
  <header class="bg-navy-800 text-[#e6ebf1]">
    <div class="mx-auto max-w-4xl px-5 pt-6 pb-9 sm:px-10">
      <a href="/#projects" class="text-[13px] text-navy-300 hover:text-white">← Projects</a>
      <h1 class="mt-5 text-[26px] leading-snug font-bold text-balance sm:text-[32px]">{d.title}</h1>
      <p class="mt-1 max-w-[60ch] text-navy-200">{d.summary}</p>
      <dl class="mt-6 grid gap-x-6 gap-y-3 border-t border-navy-600 pt-5 sm:grid-cols-2 md:grid-cols-4">
        {
          meta.map((m) => (
            <div>
              <dt class="text-[11px] tracking-[0.12em] text-navy-300 uppercase">{m.label}</dt>
              <dd class="mt-0.5 text-sm">{m.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        (d.repo || d.demo) && (
          <div class="mt-5 flex flex-wrap gap-2 text-[13px]">
            {d.repo && (
              <a
                href={d.repo}
                target="_blank"
                rel="noopener"
                class="rounded-md border border-navy-600 px-3 py-1.5 hover:border-navy-300"
              >
                GitHub 레포
              </a>
            )}
            {d.demo && (
              <a
                href={d.demo}
                target="_blank"
                rel="noopener"
                class="rounded-md bg-sky px-3 py-1.5 font-semibold text-[#102033]"
              >
                데모 보기
              </a>
            )}
          </div>
        )
      }
    </div>
  </header>

  <main class="mx-auto grid max-w-4xl gap-12 px-5 py-10 sm:px-10 sm:py-12">
    <article class="prose-project">
      <Content />
    </article>

    {
      d.troubleshooting.map((t) => (
        <section>
          <h2 class="mb-3 text-[1.2rem] font-bold">트러블슈팅 · {t.title}</h2>
          <dl class="overflow-hidden rounded-xl border border-line">
            {steps.map((s) => (
              <div
                class:list={[
                  "grid border-t border-line first:border-t-0 sm:grid-cols-[6rem_1fr]",
                  s.key === "result" && "bg-[#f3f8ff]",
                ]}
              >
                <dt
                  class:list={[
                    "px-4 pt-3 text-[13px] font-semibold sm:py-3.5",
                    s.key === "result" ? "text-[#1f5fae] sm:bg-[#e8f2ff]" : "text-[#3c4a5a] sm:bg-[#f5f8fb]",
                  ]}
                >
                  {s.label}
                </dt>
                <dd class="min-w-0 px-4 pt-1 pb-3.5 text-[14.5px] text-body sm:py-3.5" set:html={inline(t[s.key])} />
              </div>
            ))}
          </dl>
        </section>
      ))
    }

    {
      d.lesson && (
        <section>
          <h2 class="mb-3 text-[1.2rem] font-bold">배운 점</h2>
          <p class="max-w-[65ch] leading-relaxed text-body">{d.lesson}</p>
        </section>
      )
    }

    <a href="/#projects" class="text-sm font-semibold text-accent hover:underline">← 프로젝트 목록으로</a>
  </main>
</Layout>
