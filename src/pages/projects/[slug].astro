---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SpecHeader from "../../components/spec/SpecHeader.astro";
import TroubleshootingForm from "../../components/spec/TroubleshootingForm.astro";
import { profile } from "../../data/profile";
import { getPublishedProjects, type PublishedProject } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: PublishedProject };
const { Content } = await render(project);
const d = project.data;
---

<Layout title={`${d.title} | ${profile.siteTitle}`} description={d.summary}>
  <main class="wrap">
    <a href="/#projects" class="back">← 서류철로 돌아가기</a>

    <article class="sheet spec">
      <SpecHeader project={project} />

      <div class="spec-body">
        <div class="spec-prose">
          <Content />
        </div>

        {d.troubleshooting.map((item) => <TroubleshootingForm item={item} />)}

        {
          d.lesson && (
            <section class="spec-clause">
              <h2>배운 점</h2>
              <p>{d.lesson}</p>
            </section>
          )
        }
      </div>

      <div class="fine">
        <span>Terms &amp; Conditions · 본 명세서의 수치는 측정 환경에 따라 달라질 수 있습니다.</span>
        <span>{profile.docNo}-F{project.fileNo}</span>
      </div>
    </article>
  </main>
</Layout>

<style>
  .wrap {
    max-width: 948px;
    margin: 0 auto;
    padding: 28px max(16px, env(safe-area-inset-right, 0px)) 64px max(16px, env(safe-area-inset-left, 0px));
  }
  .back {
    display: inline-block;
    margin-bottom: 18px;
    color: #c9c5bc;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .back:hover {
    color: var(--color-lime);
  }
  .spec-body {
    padding: 8px 24px 30px;
  }
  .fine {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 24px;
    border-top: 1.5px solid var(--color-ink);
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  @media (max-width: 520px) {
    .spec-body {
      padding: 4px 16px 24px;
    }
  }
</style>
