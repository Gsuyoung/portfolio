---
import { existsSync } from "node:fs";
import { join } from "node:path";
import Layout from "../layouts/Layout.astro";
import Desk from "../components/desk/Desk.astro";
import RecordHead from "../components/record/RecordHead.astro";
import FormRow from "../components/record/FormRow.astro";
import ProjectFileCard from "../components/record/ProjectFileCard.astro";
import ContactGrid from "../components/record/ContactGrid.astro";
import { profile, skills, experience } from "../data/profile";
import { getPublishedProjects, emptyMessage } from "../lib/projects";

const projects = await getPublishedProjects();

// 외부 링크면 그대로 쓰고, public/ 안의 파일이면 실제로 있을 때만 이력서 칸을 보여줍니다.
const hasResume =
  !!profile.resume &&
  (/^https?:\/\//.test(profile.resume) || existsSync(join(process.cwd(), "public", profile.resume)));

const contacts = [
  { label: "E-mail", value: profile.email, href: `mailto:${profile.email}` },
  { label: "GitHub", value: profile.github.replace("https://", ""), href: profile.github },
  ...(hasResume ? [{ label: "Resume", value: "이력서 보기", href: profile.resume }] : []),
];

const tabs = [
  { href: "#profile", text: "01 PROFILE" },
  { href: "#projects", text: "02 PROJECTS" },
  { href: "#contact", text: "03 CONTACT" },
];
---

<Layout>
  <div class="wrap">
    <Desk />

    <div class="file-wrap">
      <nav class="tabs" aria-label="서류철 바로가기">
        {tabs.map((t, i) => <a href={t.href} class:list={{ on: i === 0 }}>{t.text}</a>)}
      </nav>

      <div class="sheet file">
        <RecordHead />

        <FormRow no="01" title="소개" label="About" id="profile">
          <div class="about">{profile.about.map((p) => <p>{p}</p>)}</div>
        </FormRow>

        <FormRow no="02" title="보유 기술" label="Skills" id="skills">
          <div class="checks">
            {
              skills.map((s) => (
                <div>
                  <h3 class="label">{s.group}</h3>
                  <ul>
                    {s.items.map((i) => (
                      <li>{i}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </FormRow>

        <FormRow no="03" title="경력" label="Experience" id="experience">
          <div class="ledger-wrap">
            <table class="ledger">
              <thead><tr><th>기간</th><th>소속 · 직무</th><th>주요 업무</th></tr></thead>
              <tbody>
                {
                  experience.map((e) => (
                    <tr>
                      <td class="mono">{e.period}</td>
                      <td><b>{e.title}</b></td>
                      <td>{e.items.join(", ")}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </FormRow>

        <FormRow no="04" title="프로젝트" label="Projects" id="projects">
          {
            projects.length === 0 ? (
              <p class="empty">{emptyMessage}</p>
            ) : (
              <div class="cards">
                {projects.map((p) => (
                  <ProjectFileCard project={p} />
                ))}
              </div>
            )
          }
        </FormRow>

        <FormRow no="05" title="연락처" label="Contact" id="contact">
          <ContactGrid items={contacts} />
        </FormRow>
      </div>
    </div>

    <footer class="foot">
      <span>© {new Date().getFullYear()} {profile.nameSign}</span>
      <span>{profile.docNo}</span>
    </footer>
  </div>
</Layout>

<style>
  .wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 28px max(16px, env(safe-area-inset-right, 0px)) 64px max(16px, env(safe-area-inset-left, 0px));
  }
  .file-wrap {
    position: relative;
    margin-top: 72px;
  }
  .tabs {
    position: absolute;
    left: 20px;
    bottom: 100%;
    display: flex;
    gap: 4px;
  }
  .tabs a {
    padding: 6px 14px 4px;
    border-radius: 6px 6px 0 0;
    background: var(--color-paper-2);
    color: var(--color-ink-soft);
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }
  .tabs a.on,
  .tabs a:hover {
    background: var(--color-paper);
    color: var(--color-ink);
    font-weight: 600;
  }
  .about p {
    max-width: 62ch;
    font-size: 16px;
  }
  .about p + p {
    margin-top: 8px;
    color: var(--color-ink-soft);
    font-size: 15px;
  }
  .checks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 16px 28px;
  }
  .checks h3 {
    margin-bottom: 6px;
  }
  .checks ul {
    display: grid;
    gap: 3px;
    font-size: 14.5px;
  }
  .checks li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .checks li::before {
    content: "✓";
    display: grid;
    place-items: center;
    width: 15px;
    height: 15px;
    border: 1.5px solid var(--color-ink);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
  }
  .ledger-wrap {
    overflow-x: auto;
  }
  .ledger {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .ledger th {
    padding: 0 12px 8px 0;
    border-bottom: 1.5px solid var(--color-ink);
    color: var(--color-ink-soft);
    font-weight: 500;
    text-align: left;
  }
  .ledger td {
    padding: 12px 12px 12px 0;
    border-bottom: 1px solid var(--color-hair);
    vertical-align: top;
  }
  .ledger td.mono {
    font-family: var(--font-mono);
    font-size: 13px;
    white-space: nowrap;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
  }
  .empty {
    padding: 28px 16px;
    border: 1.5px dashed var(--color-ink-soft);
    color: var(--color-ink-soft);
    text-align: center;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 20px;
    color: #9a968e;
    font-family: var(--font-mono);
    font-size: 12px;
  }
</style>
